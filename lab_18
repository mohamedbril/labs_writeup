Étape 3 : Script Frida – Appel manuel de Password()Crée le fichier frida_firestorm.js :javascript

Java.perform(function() {

    function getPassword() {
        console.log("[*] Recherche d'instances de MainActivity...");

        Java.choose('com.pwnsec.firestorm.MainActivity', {
            onMatch: function(instance) {
                console.log("[+] Instance trouvée : " + instance);

                try {
                    var pass = instance.Password();
                    console.log("[+] Mot de passe généré : " + pass);
                } catch (e) {
                    console.log("[-] Erreur : " + e);
                }
            },
            onComplete: function() {
                console.log("[*] Recherche terminée.");
            }
        });
    }

    console.log("[*] Script chargé – attente de 3 secondes...");
    setTimeout(getPassword, 3000);
});

Lancement :bash

frida -U -f com.pwnsec.firestorm -l frida_firestorm.js --no-pause

